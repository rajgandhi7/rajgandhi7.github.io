@article{GNO,
  bibtex_show={true},
  title={Thermosolutal instabilities in a moderately dense nanoparticle suspension},
  volume={1011},
  DOI={10.1017/jfm.2025.374},
  journal={J. Fluid Mech.},
  author={Gandhi, R. and Nepomnyashchy, A. and Oron, A.},
  year={2025},
  pages={A52},
  url={https://www.cambridge.org/core/journals/journal-of-fluid-mechanics/article/thermosolutal-instabilities-in-a-moderately-dense-nanoparticle-suspension/635CC03E2982DE4456E706EFA3C6A7F3},
  pdf={JFM_1_pdf.pdf},
  abstract= {We investigate the onset of thermosolutal instabilities in a moderately dense nanoparticle suspension layer with a deformable interface. The suspension is deposited on a solid substrate subjected to a specified constant heat flux. The Soret effect and the action of gravity are taken into account. A mathematical model for the system considered with nanoparticle concentration-dependent density, viscosity, thermal conductivity and the Soret coefficient is presented in dimensional and non-dimensional forms. Linear stability analysis of the obtained base state is carried out using disturbances in the normal mode, and the corresponding eigenvalue problem is derived and numerically investigated. The onset of various instabilities is investigated for cases of both heating and cooling at the substrate. The monotonic solutocapillary instability is found in the case of cooling at the substrate, which exhibits two competing mechanisms that belong to two different disturbance wavelength domains. We identify the occurrence of both monotonic and oscillatory thermocapillary instabilities when the system is heated at the substrate. Furthermore, we show the emergence of the solutal buoyancy instability due to density variation which is promoted by the Soret effect adding nanoparticles heavier than the carrier fluid in the proximity of the layer interface. Transitions from the monotonic to oscillatory thermocapillary instability are found with variation in the gravity- and solutocapillarity-related parameters. Notably, we identify a previously unknown transition from monotonic to the oscillatory thermocapillary instability due to the variation in the strength of the thermal-conductivity stratification coupled with the Soret effect.},
  preview={jfm_abs.jpg},
  selected={true}
   }  



@article{10.1063/5.0289945,
    bibtex_show={true},
    author={Gandhi, R. and Nepomnyashchy, A. and Oron, A.},
    title = {The onset of long-wave oscillatory thermosolutal instability in a heated layer of a moderately dense nanofluid},
    journal = {Phys. Fluids},
    volume = {37},
    number = {9},
    pages = {092120},
    year = {2025},
    month = {09},
    abstract = {We investigate the thermosolutal Marangoni instability in a moderately dense nanoparticle suspension (nanofluid). The nanofluid layer deposited on a solid substrate and subjected to a specified constant heat flux is exposed to the ambient atmosphere at the air–liquid deformable interface. The effects of thermophoresis and gravity are considered. Using the method of asymptotic expansions, we investigate the oscillatory long-wave thermosolutocapillary instabilities, taking into consideration the dependence of the thermophysical properties of the nanofluid on the local nanoparticle concentration. Variations in the threshold of the long-wave oscillatory thermocapillary instability with the heat transfer rate at the interface and the interface deformability are obtained. We find a transition from monotonic to oscillatory thermosolutal Marangoni instability with a codimension-two point bifurcation. An excellent agreement is obtained between the results of the asymptotic analysis and those of the numerical solution of the full eigenvalue problem, in terms of the critical values of the Marangoni number, the wavenumber, and the frequency.},
    issn = {1070-6631},
    doi = {10.1063/5.0289945},
    url = {https://doi.org/10.1063/5.0289945},
    eprint = {https://pubs.aip.org/aip/pof/article-pdf/doi/10.1063/5.0289945/20700722/092120_1_5.0289945.pdf},
    preview={hb_lw_MT_a_grph.jpg},
    pdf={POF_GNO_pdf.pdf},
}



@article{GNO3,
  bibtex_show={true},
  author={Gandhi, R. and Nepomnyashchy, A. and Oron, A.},
  title={Longwave thermosolutal instability in a moderately dense nanoparticle suspension},
  journal={Eur. Phys. J. Special Topics},
  year={2025},
  month={Sep},
  day={29},
  abstract={We carry out the long-wave analysis of the monotonic thermo-solutocapillary instability coupled with the Soret effect in a layer of a moderately dense nanofluid layer with the deformable interface exposed to the ambient gas phase in the gravity field. The results of the long-wave analysis are compared with those obtained from the fully numerical solution of the pertinent linear eigenvalue problem formulated for the problem at hand, and the agreement is found to be excellent.},
  issn={1951-6401},
  doi={10.1140/epjs/s11734-025-01960-x},
  url={https://doi.org/10.1140/epjs/s11734-025-01960-x},
  preview={fig7_graphical_abstract.jpg},
  pdf={EPJST_GNO_PDF.pdf},
}

